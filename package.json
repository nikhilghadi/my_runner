{
  "name": "my_runner",
  "slug": "my-runner",
  "version": "1.0.0",
  "main": "index.ts",
  "android": {
    "package": "com.myrunner.app",
    "permissions": [
      "ACCESS_FINE_LOCATION",
      "ACCESS_COARSE_LOCATION",
      "FOREGROUND_SERVICE",
      "FOREGROUND_SERVICE_LOCATION",
      "POST_NOTIFICATIONS",
      "VIBRATE"
    ]
  },
  "plugins": [
    [
      "expo-location",
      {
        "isAndroidForegroundServiceEnabled": true,
        "isAndroidBackgroundLocationEnabled": false
      }
    ]
  ],
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-file-system": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
